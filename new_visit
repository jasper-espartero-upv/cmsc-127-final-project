<?php
require_once 'DBConnector.php';

$conn = new mysqli($servername, $username, $password, $dbname);
if ($conn->connect_error) {
    die("Connection failed: " . $conn->connect_error);
}

session_start();

if (!isset($_SESSION['staff_ID'])) {
    header('Location: login.php');
    exit;
}

$logged_in_staff = $_SESSION['staff_ID'];

function sanitize($conn, $val) {
    return $conn->real_escape_string(trim($val));
}

// FETCH DATA
$message = '';
$msgType = 'success';

$patients_result = $conn->query("
    SELECT patient_ID,
           CONCAT(first_name,' ',last_name) AS full_name
    FROM patient
    ORDER BY last_name ASC
");

$physicians_result = $conn->query("
    SELECT physician_ID,
           CONCAT(first_name,' ',last_name) AS full_name
    FROM physician
    ORDER BY last_name ASC
");

$patients   = $patients_result ? $patients_result->fetch_all(MYSQLI_ASSOC) : [];
$physicians = $physicians_result ? $physicians_result->fetch_all(MYSQLI_ASSOC) : [];

// CREATE VISIT 
if ($_SERVER['REQUEST_METHOD'] === 'POST') {

    $today = date('Y-m-d');

    $patient_mode = $_POST['patient_mode'] ?? 'existing';

    if ($patient_mode === 'new') {

        // CREATE NEW PATIENT FIRST
        $first_name      = sanitize($conn, $_POST['first_name'] ?? '');
        $last_name       = sanitize($conn, $_POST['last_name'] ?? '');
        $birthdate       = sanitize($conn, $_POST['birthdate'] ?? '');
        $sex             = sanitize($conn, $_POST['sex'] ?? '');
        $contact_number  = sanitize($conn, $_POST['contact_number'] ?? '');
        $emerg_name      = sanitize($conn, $_POST['emergency_contact_name'] ?? '');
        $emerg_number    = sanitize($conn, $_POST['emergency_contact_number'] ?? '');
        $affiliation     = sanitize($conn, $_POST['affiliation'] ?? '');

        $insert_patient = "
            INSERT INTO patient
            (
                first_name,
                last_name,
                birthdate,
                sex,
                contact_number,
                emergency_contact_name,
                emergency_contact_number,
                affiliation,
                created_at,
                updated_at,
                created_by
            )
            VALUES
            (
                '$first_name',
                '$last_name',
                '$birthdate',
                '$sex',
                '$contact_number',
                '$emerg_name',
                '$emerg_number',
                '$affiliation',
                '$today',
                '$today',
                '$logged_in_staff'
            )
        ";

        if (!$conn->query($insert_patient)) {
            $message = "Error adding patient: " . $conn->error;
            $msgType = 'error';
        }

        $patient_id = $conn->insert_id;

    } else {
        $patient_id = (int)($_POST['patient_id'] ?? 0);
    }

    if ($msgType !== 'error') {

        $physician_id = (int)$_POST['physician_id'];
        $visit_date   = sanitize($conn, $_POST['visit_date']);
        $symptoms     = sanitize($conn, $_POST['symptoms']);
        $prescription = sanitize($conn, $_POST['prescription']);

        $sql = "
            INSERT INTO patient_visits
            (
                symptoms_description,
                prescription_details,
                visit_date,
                created_at,
                updated_at,
                patient_ID,
                physician_ID,
                created_by
            )
            VALUES
            (
                '$symptoms',
                '$prescription',
                '$visit_date',
                '$today',
                '$today',
                $patient_id,
                $physician_id,
                $logged_in_staff
            )
        ";

        if ($conn->query($sql)) {
            $message = "Visit created successfully.";
        } else {
            $message = "Error creating visit: " . $conn->error;
            $msgType = 'error';
        }
    }
}
