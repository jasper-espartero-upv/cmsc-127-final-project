<script>

/* ── Patient search bar ── */
const patientSearch  = document.getElementById('patientSearch');
const patientSelect  = document.getElementById('patientSelect');
const searchClear    = document.getElementById('searchClear');
const searchIcon     = document.getElementById('searchIcon');
const patientCount   = document.getElementById('patientCount');

// Cache all options (skip the placeholder at index 0)
const allOptions = Array.from(patientSelect.options).slice(1).map(opt => ({
    value : opt.value,
    text  : opt.text,
    lower : opt.text.toLowerCase() + ' ' + opt.value  // include ID for searching
}));

function updateCount(visible, total) {
    patientCount.textContent = visible === total
        ? `${total} patient${total !== 1 ? 's' : ''}`
        : `${visible} of ${total} patient${total !== 1 ? 's' : ''} shown`;
}

function filterPatients() {
    const q = patientSearch.value.trim().toLowerCase();

    // Rebuild option list to preserve DOM order
    patientSelect.innerHTML = '<option value="">— Select Patient —</option>';

    let visibleCount = 0;
    allOptions.forEach(({ value, text, lower }) => {
        if (!q || lower.includes(q)) {
            const opt = document.createElement('option');
            opt.value = value;
            opt.textContent = text;
            patientSelect.appendChild(opt);
            visibleCount++;
        }
    });

    updateCount(visibleCount, allOptions.length);

    // Show/hide clear button
    searchClear.style.display = q ? 'block' : 'none';
    searchIcon.style.display  = q ? 'none'  : 'block';
}

// Initial count
updateCount(allOptions.length, allOptions.length);

patientSearch.addEventListener('input', () => {
    openList();
    filterPatients();
});

searchClear.addEventListener('click', () => {
    clearSelection();
    patientSearch.focus();
});

// Focus search when switching to Existing Patient tab
btnExisting.addEventListener('click', () => {
    setTimeout(() => patientSearch.focus(), 50);
});

/* -- Collapse / expand list -- */
function openList() {
    patientSelect.size = 5;
    patientSelect.style.display = '';
    patientCount.style.display  = '';
}

function closeList(selectedText) {
    patientSelect.size = 1;
    patientSelect.style.display = 'none';
    patientCount.style.display  = 'none';
    patientSearch.value    = selectedText;
    patientSearch.readOnly = true;
    searchClear.style.display = 'block';
    searchIcon.style.display  = 'none';
}

function clearSelection() {
    patientSelect.value        = '';
    patientSearch.value        = '';
    patientSearch.readOnly     = false;
    filterPatients();
    openList();
}

patientSelect.addEventListener('change', () => {
    const selected = patientSelect.options[patientSelect.selectedIndex];
    if (selected && selected.value) {
        closeList(selected.text.trim());
    }
});


const btnNew      = document.getElementById('btnNew');

const existingSection = document.getElementById('existingPatientSection');
const newSection      = document.getElementById('newPatientSection');

const patientMode = document.getElementById('patientMode');

btnExisting.addEventListener('click', () => {

    patientMode.value = 'existing';

    btnExisting.classList.add('active');
    btnNew.classList.remove('active');

    existingSection.classList.remove('hidden');
    newSection.classList.add('hidden');

});

btnNew.addEventListener('click', () => {

    patientMode.value = 'new';

    btnNew.classList.add('active');
    btnExisting.classList.remove('active');

    existingSection.classList.add('hidden');
    newSection.classList.remove('hidden');

});

</script>

